{
  "compilerOptions": {
    "target": "ES2015",
    "module": "commonjs",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "./src/types"
  },
  "include": ["./src/**/*", "babel.config.js", "config/jest/setupTests.ts"],
  "exclude": ["node_modules", "**/*.spec.ts", "**/*.test.ts"],
  "typeAcquisition": {
    "include": ["jest"]
  }
}
